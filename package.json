{
  "name": "racer-online",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:verify": "node scripts/verify-vehicle-wasm.mjs",
    "server": "node server/index.mjs",
    "dev:online": "concurrently -k -n web,ws -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "snapshot-version": "node scripts/snapshot-version.mjs",
    "start": "node server/index.mjs",
    "start:prod": "node server/index.mjs",
    "start:local": "npm run dev:online",
    "test:full": "node scripts/full-suite.mjs",
    "test:early-finish": "node scripts/verify-early-finish.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.18.3"
  }
}
